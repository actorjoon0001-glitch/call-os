# ──────────────────────────────────────────────
# Supabase (프론트엔드용)
# ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ──────────────────────────────────────────────
# 서버리스 함수용 (Edge Function / Lambda / Vercel Serverless)
# ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 고객 통화 시 ARS 멘트에 사용할 회사명
COMPANY_NAME=우리회사

# ARS 벨 울림 타임아웃 (초)
RING_TIMEOUT_SECONDS=15

# ──────────────────────────────────────────────
# AI 안내원 (방문예약 유도) — Anthropic Claude
# ──────────────────────────────────────────────
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
# 음성 통화 특성상 낮은 지연이 중요 → 기본은 빠른 Haiku 계열
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 외부 전화 시스템(ClawOps 등)이 방문예약을 저장할 때 쓰는 공유 시크릿
# save-reservation 엔드포인트 보호용. clawops-agent 의 값과 동일하게 설정.
RESERVATION_WEBHOOK_SECRET=change-me-to-a-random-string

# ──────────────────────────────────────────────
# 통신사 어댑터 선택
# 사용 가능: twilio (기본값) | sejong (예정) | kt (예정)
# ──────────────────────────────────────────────
TELEPHONY_PROVIDER=twilio

# Twilio (개발/시연용)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+8215001234

# 국내 통신사 (계약 후 추가)
# SEJONG_API_KEY=
# KT_BIZCALL_KEY=
