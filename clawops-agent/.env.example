# ClawOps 인증 (콘솔에서 발급)
CLAWOPS_API_KEY=sk_...
CLAWOPS_ACCOUNT_ID=AC...

# 발급받은 070 번호 (하이픈 없이)
CLAWOPS_FROM_NUMBER=07012345678

# CALL-OS 예약 저장 엔드포인트
CALLOS_SAVE_URL=https://call-os.netlify.app/.netlify/functions/save-reservation
# Netlify에 설정한 값과 동일하게 (없으면 비워둠)
RESERVATION_WEBHOOK_SECRET=

# 음성/언어 (선택)
AGENT_VOICE=marin
AGENT_LANGUAGE=ko
